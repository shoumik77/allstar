generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WeekStatus {
  OPEN
  SETTLING
  CLOSED
}

enum GameStatus {
  SCHEDULED
  IN_PROGRESS
  FINAL
  POSTPONED
}

enum PickType {
  MONEYLINE
  SPREAD
}

enum TeamSide {
  HOME
  AWAY
}

enum PickStatus {
  OPEN
  LOCKED
  VOID
  SETTLED
}

enum OrderSide {
  WITH
  AGAINST
}

enum OrderStatus {
  OPEN
  PARTIAL
  FILLED
  CANCELLED
}

enum MatchResult {
  PENDING
  WITH_WON
  AGAINST_WON
  PUSH
}

enum TransactionType {
  STAKE
  REFUND
  PAYOUT
  ORDER_CANCEL
  UNMATCHED_REFUND
  WEEKLY_RESET
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  username      String   @unique
  passwordHash  String
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())

  balances     WeeklyBalance[]
  picks        Pick[]
  orders       Order[]
  transactions Transaction[]
}

model Week {
  id            String     @id @default(cuid())
  season        Int
  nflWeekNumber Int
  startsAt      DateTime
  endsAt        DateTime
  status        WeekStatus @default(OPEN)

  games        Game[]
  balances     WeeklyBalance[]
  transactions Transaction[]

  @@unique([season, nflWeekNumber])
}

model WeeklyBalance {
  id      String @id @default(cuid())
  userId  String
  weekId  String
  balance Int    @default(1000)
  locked  Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  week Week @relation(fields: [weekId], references: [id], onDelete: Cascade)

  @@unique([userId, weekId])
}

model Game {
  id         String     @id @default(cuid())
  externalId String     @unique
  weekId     String
  homeTeam   String
  awayTeam   String
  kickoff    DateTime
  status     GameStatus @default(SCHEDULED)
  homeScore  Int?
  awayScore  Int?

  // Current market odds (American). `spread` is the home team's line, e.g. -3.5
  homeMoneyline  Int?
  awayMoneyline  Int?
  spread         Float?
  homeSpreadOdds Int?
  awaySpreadOdds Int?
  oddsUpdatedAt  DateTime?

  week  Week   @relation(fields: [weekId], references: [id], onDelete: Cascade)
  picks Pick[]

  @@index([weekId])
}

model Pick {
  id        String     @id @default(cuid())
  creatorId String
  gameId    String
  type      PickType
  side      TeamSide
  status    PickStatus @default(OPEN)
  createdAt DateTime   @default(now())

  // Odds snapshot taken at pick creation — payouts are pinned to these.
  line              Float? // spread line for the chosen side (null for moneyline)
  snapHomeMoneyline Int?
  snapAwayMoneyline Int?
  snapSpread        Float?
  snapHomeSpreadOdds Int?
  snapAwaySpreadOdds Int?
  sideOdds          Int // American odds for the pick's side (WITH orders)
  fadeOdds          Int // American odds for the opposite side (AGAINST orders)

  creator      User          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  game         Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  orders       Order[]
  matches      Match[]
  transactions Transaction[]

  @@index([gameId])
  @@index([status])
}

// An offer resting on a pick's book. `risked` is what the user put up:
// the stake for WITH orders, the liability for AGAINST orders.
model Order {
  id        String      @id @default(cuid())
  pickId    String
  userId    String
  side      OrderSide
  risked    Int
  matched   Int         @default(0) // portion of `risked` consumed by matches
  refunded  Int         @default(0) // released back on cancel / kickoff sweep
  limitOdds Int // American odds expressed on the WITH side
  status    OrderStatus @default(OPEN)
  createdAt DateTime    @default(now())

  pick          Pick          @relation(fields: [pickId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  withMatches   Match[]       @relation("WithOrder")
  againstMatches Match[]      @relation("AgainstOrder")
  transactions  Transaction[]

  @@index([pickId, side, status])
  @@index([userId])
}

// A locked-in bet between two orders. The winner takes both risked amounts.
model Match {
  id               String      @id @default(cuid())
  pickId           String
  withOrderId      String
  againstOrderId   String
  withStake        Int
  againstLiability Int
  odds             Int // executed American odds, WITH side
  result           MatchResult @default(PENDING)
  settledAt        DateTime?
  createdAt        DateTime    @default(now())

  pick         Pick          @relation(fields: [pickId], references: [id], onDelete: Cascade)
  withOrder    Order         @relation("WithOrder", fields: [withOrderId], references: [id], onDelete: Cascade)
  againstOrder Order         @relation("AgainstOrder", fields: [againstOrderId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([pickId])
}

model Transaction {
  id         String          @id @default(cuid())
  userId     String
  weekId     String
  type       TransactionType
  amount     Int // signed: negative for stakes, positive for refunds/payouts
  pickId     String?
  orderId    String?
  matchId    String?
  note       String?
  createdAt  DateTime        @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  week  Week   @relation(fields: [weekId], references: [id], onDelete: Cascade)
  pick  Pick?  @relation(fields: [pickId], references: [id], onDelete: SetNull)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  match Match? @relation(fields: [matchId], references: [id], onDelete: SetNull)

  @@index([userId, weekId])
}
